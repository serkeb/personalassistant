# ========================================
# CONFIGURACIÓN DE SUPABASE
# ========================================
# Obtén estos valores desde tu dashboard de Supabase:
# 1. Ve a https://app.supabase.com
# 2. Seleccioná tu proyecto
# 3. Ve a Settings > API
# 4. Copiá los valores y pegálos acá

# URL de tu proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon key) - es segura para usar en el frontend
SUPABASE_ANON_KEY=tu-clave-anon-key-aqui

# ========================================
# CONFIGURACIÓN DE GEMINI API
# ========================================
# Para obtener tu API key de Gemini:
# 1. Ve a https://makersuite.google.com/app/apikey
# 2. Creá una nueva API key
# 3. Copiála acá

GEMINI_API_KEY=tu-gemini-api-key-aqui

# ========================================
# CONFIGURACIÓN DE GOOGLE CALENDAR API
# (Opcional - para Fase 2)
# ========================================
GOOGLE_CALENDAR_API_KEY=tu-google-calendar-api-key-aqui

# ========================================
# NOTAS IMPORTANTES
# ========================================
# 1. NUNCA subas este archivo a GitHub con valores reales
# 2. Creá un archivo .env (sin .example) con tus valores reales
# 3. El archivo .env está en .gitignore y no se subirá
